# Copy to .env and edit. Every setting has a working default.

# Database: empty = SQLite file in data/. For PostgreSQL (docker compose up -d db):
# PB_DATABASE_URL=postgresql+psycopg2://porabondhu:porabondhu@localhost:5432/porabondhu
PB_DATABASE_URL=

# Speech model (Hugging Face id or a local folder, e.g. data/models/adapted)
PB_CTC_MODEL_ID=arijitx/wav2vec2-xls-r-300m-bengali
# auto = use data/onnx/model.int8.onnx if present (fastest on CPU), else PyTorch
PB_CTC_BACKEND=auto
# Whisper baseline size: tiny | base | small | medium
PB_WHISPER_SIZE=small
PB_ENABLE_WHISPER=true
# 0 = use all CPU cores
PB_TORCH_THREADS=0
# Load the CTC model at start-up instead of on the first reading
PB_PRELOAD_MODELS=false

# Weak pattern = at least N errors across at least M readings
PB_WEAK_MIN_ERRORS=3
PB_WEAK_MIN_READINGS=2
PB_COUNT_UNSURE_AS_CORRECT=true

# First start only (while there are no users): demo teacher, Class 1-5 and student logins
PB_SEED_DEMO=true
# How long a login lasts
PB_SESSION_DAYS=14

# Privacy: delete recordings this many days after upload unless the teacher ticked "keep" (0 = never)
PB_AUDIO_RETENTION_DAYS=14
# Security: lock a login for PB_LOCKOUT_MINUTES after PB_MAX_FAILED_LOGINS wrong passwords in a row
PB_MAX_FAILED_LOGINS=5
PB_LOCKOUT_MINUTES=10
